# Copy this file to .env in this folder (the repo root) and fill in your values. Never commit .env.
# Add your name to ensure tracing to your project
ATTENDEE_NAME=<replace-with-your-name>

# The model is reached through the LangSmith LLM Gateway (see the gateway block at the bottom of this file)
MODEL_NAME="openai:gpt-6-luna"

# =============================================================================
# LANGSMITH - CONFIGURATION
# =============================================================================
LANGSMITH_TRACING="true"
LANGSMITH_API_URL="https://api.smith.langchain.com"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=<replace-with-your-api-key>
LANGSMITH_WORKSPACE_ID=<replace-with-your-workspace-id>
LANGSMITH_PROJECT="fsi-hackathon-${ATTENDEE_NAME}"

# =============================================================================
# LANGSMITH - GATEWAY
# =============================================================================
LC_GATEWAY_KEY=${LANGSMITH_API_KEY}

OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
OPENAI_API_KEY=${LC_GATEWAY_KEY}

TYPESAFE_BASE_URL="https://gateway.smith.langchain.com"
TYPESAFE_API_KEY=${LC_GATEWAY_KEY}
