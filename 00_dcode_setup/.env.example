# Copy this file to ~/.deepagents/.env and fill in your values. Never commit .env.
# Add your name to ensure tracing to your project
ATTENDEE_NAME=<replace-with-your-name>

# =============================================================================
# LANGSMITH
# =============================================================================
LANGSMITH_TRACING="true"

DEEPAGENTS_CODE_LANGSMITH_PROJECT=deepagents-code-${ATTENDEE_NAME}
DEEPAGENTS_CODE_LANGSMITH_API_URL="https://api.smith.langchain.com"
DEEPAGENTS_CODE_LANGSMITH_API_KEY=<replace-with-your-api-key>
DEEPAGENTS_CODE_LANGSMITH_WORKSPACE_ID=<replace-with-your-workspace-id>

# =============================================================================
# LANGSMITH - GATEWAY
# =============================================================================
LC_GATEWAY_KEY=${DEEPAGENTS_CODE_LANGSMITH_API_KEY}

DEEPAGENTS_CODE_OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
DEEPAGENTS_CODE_OPENAI_API_KEY=${DEEPAGENTS_CODE_LANGSMITH_API_KEY}